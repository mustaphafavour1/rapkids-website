# Copy this file to .env.local for local development. On Vercel, add these
# as Project → Settings → Environment Variables instead.

# --- Chatbot (required for the chat widget to answer questions) -------------
# Anthropic API key. The chat route uses Claude Haiku 4.5 (the cheapest
# current model) — see lib/anthropic.ts to change it.
ANTHROPIC_API_KEY=

# --- Chatbot knowledge base (optional, but recommended) ---------------------
# Four Google Docs, one per topic — paste each doc's share link (or just its
# ID). Each doc MUST be shared as "Anyone with the link → Viewer" (Share →
# General access) so the server can read it without signing in as anyone.
# Leave any of these blank to skip that section; the chatbot still works off
# the site's own content (prizes/rules/FAQ) either way.
#
# Edits typically show up within about a minute — no redeploy needed.
KB_DOC_RAPKIDS_URL=
KB_DOC_RAPTURES_URL=
KB_DOC_CHAMPIONSHIP_URL=
KB_DOC_GUIDELINES_URL=
