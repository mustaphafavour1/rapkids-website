# Copy this file to .env.local for local development. On Vercel, add these
# as Project → Settings → Environment Variables instead.

# --- Chatbot (required for the chat widget to answer questions) -------------
# Anthropic API key. The chat route uses Claude Haiku 4.5 (the cheapest
# current model) — see lib/anthropic.ts to change it.
ANTHROPIC_API_KEY=

# --- Persistent storage (recommended) ---------------------------------------
# Backs the chatbot's knowledge base (content pasted in at /admin) and its
# rate limiting. Without these, the site still runs, but knowledge-base edits
# only last for the current server process and are lost on redeploy/restart.
# Create a free database at https://console.upstash.com (or via the Vercel
# Marketplace → Upstash integration, which fills these in for you).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin page (/admin) — the chatbot's content base -----------------------
# A single shared password; there are no user accounts. Pick something long.
KB_ADMIN_PASSWORD=
# Random secret used to sign the admin session cookie. Any long random string
# works — e.g. generate one with `openssl rand -hex 32`.
KB_SESSION_SECRET=
